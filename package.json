{
  "name": "dsh-plugin-mobile-link",
  "version": "0.3.1",
  "private": true,
  "description": "DSH 与自研移动端 App 的专用移动网关：局域网直连、设备配对、会话实时同步。",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "ws": "^8.18.0",
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
